{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axisrobo.com/tekmovela.improvement-action.v1.schema.json",
  "title": "TEKMOVELA ImprovementAction v1",
  "description": "A tracked engineering action generated by the failure/anomaly -> regression -> improvement loop, linkable to an external issue or project system.",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "id", "action_type", "source_ref"],
  "properties": {
    "api_version": { "const": "tekmovela.io/v1" },
    "kind": { "const": "ImprovementAction" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "action_type": {
      "type": "string",
      "enum": ["harness_change", "scenario_add", "oracle_update", "contract_issue", "process_change"]
    },
    "source_ref": { "type": "string", "minLength": 1 },
    "owner": { "type": "string" },
    "issue_ref": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["proposed", "in_progress", "done", "won_t_do"]
    }
  }
}
