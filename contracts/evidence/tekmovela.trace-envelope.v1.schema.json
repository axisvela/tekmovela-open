{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axisrobo.com/tekmovela.trace-envelope.v1.schema.json",
  "title": "TEKMOVELA TraceEnvelope v1",
  "description": "A multi-perspective trace envelope. PPES cognitive-state traces and substrate event traces are orthogonal perspectives; the envelope correlates them without flattening semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "id", "run_ref", "perspectives"],
  "properties": {
    "api_version": { "const": "tekmovela.io/v1" },
    "kind": { "const": "TraceEnvelope" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "run_ref": { "type": "string", "minLength": 1 },
    "perspectives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["perspective_type", "uri", "digest"],
        "properties": {
          "perspective_type": {
            "type": "string",
            "enum": ["execution", "ppes", "effect", "authority", "world_state"]
          },
          "uri": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      },
      "minItems": 1
    },
    "tenant_id": { "type": "string" },
    "trace_id": { "type": "string" }
  }
}
