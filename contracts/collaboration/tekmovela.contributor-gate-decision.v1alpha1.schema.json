{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axisrobo.com/tekmovela.contributor-gate-decision.v1alpha1.schema.json",
  "title": "TEKMOVELA ContributorGateDecision v1alpha1",
  "description": "A digest-verifiable record of a contributor gate evaluation: the evidence snapshot that produced the decision. Identity and privilege truth stay with AEGIVELA; TEKMOVELA records the decision as verification evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "id", "contributor_ref", "artifact_ref", "evidence", "pass", "decided_at", "digest"],
  "properties": {
    "api_version": { "const": "tekmovela.io/v1alpha1" },
    "kind": { "const": "ContributorGateDecision" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "contributor_ref": { "type": "string", "minLength": 1 },
    "artifact_ref": { "type": "string", "minLength": 1 },
    "evidence": { "$ref": "#/$defs/evidence" },
    "pass": { "type": "boolean" },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "decided_at": { "type": "string", "format": "date-time" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_verified", "minimal_privilege_held", "artifact_digest_valid", "required_contracts_satisfied", "audit_recorded"],
      "properties": {
        "identity_verified": { "type": "boolean" },
        "minimal_privilege_held": { "type": "boolean" },
        "artifact_digest_valid": { "type": "boolean" },
        "required_contracts_satisfied": { "type": "boolean" },
        "audit_recorded": { "type": "boolean" }
      }
    }
  }
}
